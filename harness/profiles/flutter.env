# Harness profile — Flutter
#
# Generated by `harness init`, then yours to edit. Every command runs from the
# repository root. Leave a value empty to skip that step entirely.

HARNESS_PROFILE=flutter

HARNESS_INSTALL=flutter pub get
HARNESS_LINT=flutter analyze
HARNESS_TYPECHECK=
HARNESS_UNIT=flutter test
HARNESS_E2E=flutter test integration_test
HARNESS_BUILD=flutter build apk --debug

HARNESS_DEV=flutter run
HARNESS_DEV_URL=

# Flutter drives its own integration tests; `harness explore` scaffolds an
# integration_test walkthrough that dumps screenshots via IntegrationTestWidgetsFlutterBinding.
HARNESS_E2E_KIND=flutter-integration

HARNESS_SOURCE_GLOBS=lib/**/*.dart,test/**/*.dart,integration_test/**/*.dart
