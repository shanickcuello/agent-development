# Harness profile — Node web (Next.js / Vite / React / any package.json project)
#
# Generated by `harness init`, then yours to edit. Every command runs from the
# repository root. Leave a value empty to skip that step entirely.

HARNESS_PROFILE=node-web

HARNESS_INSTALL=__INSTALL__
HARNESS_LINT=__LINT__
HARNESS_TYPECHECK=__TYPECHECK__
HARNESS_UNIT=__UNIT__
HARNESS_E2E=__E2E__
HARNESS_BUILD=__BUILD__

# Used by the exploratory ("manual") tester to drive a real browser.
HARNESS_DEV=__DEV__
HARNESS_DEV_URL=__DEV_URL__

# playwright | selenium | cypress | ""  — decides how `harness explore` works.
HARNESS_E2E_KIND=__E2E_KIND__

# Comma-separated globs the gate watches. If any of these files changes after
# the last green verification, the gate refuses to close the feature.
HARNESS_SOURCE_GLOBS=src/**/*,app/**/*,lib/**/*,components/**/*,e2e/**/*,tests/**/*
