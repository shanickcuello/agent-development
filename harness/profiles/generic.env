# Harness profile — generic
#
# The stack could not be detected automatically. Fill these in by hand; every
# command runs from the repository root. Leave a value empty to skip that step.
#
# The harness is deliberately dumb about your stack: it only knows how to run
# these commands, collect their output and refuse to close a feature when one
# of them is red.

HARNESS_PROFILE=generic

HARNESS_INSTALL=
HARNESS_LINT=
HARNESS_TYPECHECK=
HARNESS_UNIT=
HARNESS_E2E=
HARNESS_BUILD=

HARNESS_DEV=
HARNESS_DEV_URL=

# playwright | playwright-python | selenium | cypress | flutter-integration | ""
HARNESS_E2E_KIND=

HARNESS_SOURCE_GLOBS=src/**/*
