# Harness profile — Go
#
# Generated by `harness init`, then yours to edit. Every command runs from the
# repository root. Leave a value empty to skip that step entirely.

HARNESS_PROFILE=go

HARNESS_INSTALL=go mod download
HARNESS_LINT=golangci-lint run
HARNESS_TYPECHECK=go vet ./...
HARNESS_UNIT=go test ./...
HARNESS_E2E=
HARNESS_BUILD=go build ./...

HARNESS_DEV=go run .
HARNESS_DEV_URL=http://localhost:8080

HARNESS_E2E_KIND=

HARNESS_SOURCE_GLOBS=**/*.go
