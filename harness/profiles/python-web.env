# Harness profile — Python web (FastAPI / FastHTML / Django / Flask)
#
# Generated by `harness init`, then yours to edit. Every command runs from the
# repository root. Leave a value empty to skip that step entirely.

HARNESS_PROFILE=python-web

HARNESS_INSTALL=pip install -r requirements.txt
HARNESS_LINT=ruff check .
HARNESS_TYPECHECK=mypy .
HARNESS_UNIT=pytest -q --ignore=tests/e2e

# pytest-playwright writes screenshots and traces into --output.
# HARNESS_REPORT_DIR is exported by the harness before each run.
HARNESS_E2E=pytest -q tests/e2e --screenshot=on --output="$HARNESS_REPORT_DIR/artifacts"
HARNESS_BUILD=

HARNESS_DEV=uvicorn app.main:app --reload --port 8000
HARNESS_DEV_URL=http://localhost:8000

HARNESS_E2E_KIND=playwright-python

HARNESS_SOURCE_GLOBS=src/**/*.py,app/**/*.py,tests/**/*.py
